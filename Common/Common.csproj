<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      纯类库，不要用 Microsoft.NET.Sdk.Web：Web SDK 会无条件给类库生成 dotnet-watch 的指纹静态资源
      (_framework/Microsoft.NET.Sdk.BlazorWeb.DotNetWatch.lib.module.js)，导致引用方 Debug 构建报
      "The following scoped css bundles do not have matching endpoints"。
    -->
  </PropertyGroup>

  <!-- 普通 SDK 不会自动引用 ASP.NET Core（Web SDK 才自动），这里显式声明一次即可 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.EntityFrameworkCore">
      <HintPath>D:\NuGet\microsoft.entityframeworkcore\9.0.9\lib\net8.0\Microsoft.EntityFrameworkCore.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
